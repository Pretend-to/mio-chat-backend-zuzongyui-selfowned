{
  "name": "mio-chat",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "version": "0.0.1",
  "description": "AI-Powered chat platform,support ONEBOT v11",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "node --watch app.js",
    "start": "pm2 start ./config/pm2.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:channel-storage": "node scripts/migrate-channel-storage.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bash scripts/utils/run-tests.sh",
    "test:unit": "node --test tests/**/*.test.js",
    "format": "prettier --write .",
    "docker:build": "docker build -t mio-chat-backend .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "gpt"
  ],
  "author": "mio",
  "license": "MIT",
  "devDependencies": {
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@imhelper/onebot-v12": "1.0.9",
    "@lobehub/icons": "^5.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@onebots/adapter-wechat-clawbot": "3.0.12",
    "@onebots/protocol-onebot-v12": "3.0.12",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@puppeteer/browsers": "^3.0.6",
    "@xterm/headless": "^6.0.0",
    "ajv": "^8.20.0",
    "api": "^7.0.0",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.3",
    "express": "^5.2.1",
    "express-static-gzip": "^2.2.0",
    "file-type": "^21.3.4",
    "google-auth-library": "^9.15.1",
    "htm": "^3.1.1",
    "imhelper": "1.0.9",
    "js-yaml": "^4.3.1",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0-beta21",
    "nodemailer": "^9.0.3",
    "officeparser": "^5.2.2",
    "onebots": "1.2.12",
    "openai": "^6.49.0",
    "puppeteer-core": "^25.3.0",
    "silk-wasm": "^3.7.1",
    "socket.io": "^4.8.3",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-powershell": "^0.26.4",
    "vhtml": "^2.2.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ],
      "allowedVersions": {
        "react": "*"
      }
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "@karinjs/node-pty",
      "prisma",
      "@prisma/engines"
    ],
    "overrides": {
      "underscore": ">=1.13.8",
      "hono": ">=4.12.34",
      "@hono/node-server": ">=1.19.15",
      "@xmldom/xmldom": ">=0.9.10",
      "basic-ftp": ">=5.3.1",
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=3.1.3",
      "fast-xml-builder": ">=1.1.6",
      "follow-redirects": ">=1.16.0",
      "ip-address": ">=10.2.2",
      "ws": ">=8.20.1",
      "uuid": ">=9.0.2",
      "qs": ">=6.15.2",
      "dompurify": ">=3.4.13",
      "mermaid": ">=11.16.1",
      "valibot": ">=1.4.2",
      "js-yaml": ">=4.3.1 <5",
      "socket.io-parser": ">=4.2.7",
      "file-type": ">=21.3.1",
      "body-parser": ">=2.3.0",
      "find-my-way": ">=9.7.0",
      "engine.io": "6.6.7",
      "deepmerge-ts": ">=8.0.0"
    },
    "patchedDependencies": {
      "@onebots/adapter-wechat-clawbot@3.0.12": "patches/@onebots__adapter-wechat-clawbot@3.0.12.patch"
    }
  }
}
